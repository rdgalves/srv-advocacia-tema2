# Variáveis do formulário de contato (Resend).
# Copie para `.env.local` e preencha com valores reais.
# NUNCA faça commit de valores reais. Nenhuma destas variáveis usa o
# prefixo NEXT_PUBLIC_, portanto permanecem exclusivamente no servidor.

# Chave privada de API do Resend (dashboard do Resend > API Keys).
RESEND_API_KEY=

# Endereço fixo que receberá as mensagens do formulário.
CONTACT_TO_EMAIL=

# Remetente autenticado/verificado no Resend (domínio verificado).
CONTACT_FROM_EMAIL=
